# Прод-шаблон для /home/app/unibot/.env на Contabo VPS.
# Скопировать в .env на сервере, заполнить реальными значениями. НЕ коммитить .env.

TELEGRAM_TOKEN=                # токен от @BotFather для прод-бота
BOT_USERNAME=UniBot            # без @, для referral-ссылок
WEBAPP_URL=https://unibot-webapp.vercel.app   # деплой на Vercel, не VPS
DATABASE_URL=postgresql://unibot:<CHANGE_ME_STRONG_PASSWORD>@postgres:5432/unibot
REDIS_URL=redis://redis:6379
OPENAI_API_KEY=
UNIX_EMAIL=                    # сервисный аккаунт UniX: каталог + транскрибы
UNIX_PASSWORD=
ENCRYPTION_KEY=                # сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_ID=                      # telegram_id админа для уведомлений о платежах
TRIBUTE_API_KEY=
TRIBUTE_WEBHOOK_SECRET=

# Примечание: POSTGRES_PASSWORD в docker-compose.yml тоже сменить с дефолтного
# "unibot" на то же значение, что в DATABASE_URL выше (docker-compose.yml сейчас
# хардкодит unibot/unibot — при желании вынести в env_file и параметризовать).
